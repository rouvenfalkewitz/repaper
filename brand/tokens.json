{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": { "brand": "RePaper", "version": "0.1", "updated": "2026-08-28" },
  "color": {
    "paper":      { "$value": "#EFF1EE", "$description": "Page ground (e-paper panel grey)" },
    "sheet":      { "$value": "#FAFBF9", "$description": "Cards, inputs, raised surfaces" },
    "ink":        { "$value": "#131614", "$description": "Text, primary fills, dark ground" },
    "graphite":   { "$value": "#454B47", "$description": "Secondary text" },
    "ash":        { "$value": "#8B928E", "$description": "Tertiary text, placeholders" },
    "line":       { "$value": "#D6DAD6", "$description": "Borders, hairlines" },
    "lineStrong": { "$value": "#B9BFBA", "$description": "Input borders" },
    "re": {
      "100": { "$value": "#DCF3EA" },
      "300": { "$value": "#7DDBBF" },
      "500": { "$value": "#14A37F", "$description": "Brand colour — fills, icons, LED, wordmark" },
      "600": { "$value": "#0F8A6B", "$description": "Hover / pressed" },
      "700": { "$value": "#0B7259", "$description": "Text & links on light (AA)" },
      "textOnDark": { "$value": "#2FCB9F", "$description": "Accent text on Ink" }
    },
    "red":   { "100": { "$value": "#FBE3DF" }, "500": { "$value": "#D6402F", "$description": "Error, destructive, urgent" } },
    "amber": { "100": { "$value": "#FCEFD0" }, "500": { "$value": "#E0A21B" }, "700": { "$value": "#8F6100", "$description": "Warning text on light" }, "textOnDark": { "$value": "#F2B84B" } },
    "blue":  { "100": { "$value": "#DEE7FA" }, "500": { "$value": "#2A62D6", "$description": "Info, setup, in progress" } },
    "dark": {
      "bg": { "$value": "#131614" }, "surface": { "$value": "#1C201D" }, "border": { "$value": "#2E3430" }, "lineStrong": { "$value": "#414843" },
      "text": { "$value": "#EFF1EE" }, "text2": { "$value": "#B9BFBA" }, "text3": { "$value": "#7E857F" }, "codeBg": { "$value": "#0E100F" },
      "re100": { "$value": "#163A30" }, "red100": { "$value": "#3E1D18" }, "amber100": { "$value": "#3B2E10" }, "blue100": { "$value": "#1A2A4D" }
    },
    "epaper": {
      "black": { "$value": "#000000" }, "white": { "$value": "#FFFFFF" }, "red": { "$value": "#C8102E" }, "yellow": { "$value": "#F2C400" },
      "panel": { "$value": "#E9EBE6", "$description": "Panel grey in sheet previews" }, "bezel": { "$value": "#2A2E2B" }
    },
    "led": {
      "$description": "RGB triplets for the Dock's WS2812 / RGB LED",
      "reGreen":    { "$value": [20, 163, 127] },
      "labelRed":   { "$value": [214, 64, 47] },
      "amber":      { "$value": [224, 162, 27] },
      "signalBlue": { "$value": [42, 98, 214] }
    }
  },
  "font": {
    "display": { "$value": "Bricolage Grotesque", "fallback": "Helvetica Neue, Arial, sans-serif", "weights": [600, 700, 800] },
    "body":    { "$value": "Figtree", "fallback": "Segoe UI, Helvetica, Arial, sans-serif", "weights": [400, 500, 600, 700] },
    "mono":    { "$value": "IBM Plex Mono", "fallback": "SF Mono, Menlo, Consolas, monospace", "weights": [400, 500] },
    "onSheet": { "$value": "Figtree", "minWeight": 500, "minSizePx": { "body": 12, "mono": 9 }, "$description": "Rendered 1-bit onto e-paper; no thin strokes" }
  },
  "typeScale": {
    "displayXl": { "font": "display", "weight": 700, "size": 64, "lineHeight": 64, "tracking": -0.03 },
    "displayL":  { "font": "display", "weight": 700, "size": 40, "lineHeight": 44, "tracking": -0.02 },
    "displayM":  { "font": "display", "weight": 600, "size": 28, "lineHeight": 32, "tracking": -0.01 },
    "title":     { "font": "body", "weight": 600, "size": 20, "lineHeight": 28 },
    "bodyL":     { "font": "body", "weight": 400, "size": 18, "lineHeight": 28 },
    "body":      { "font": "body", "weight": 400, "size": 16, "lineHeight": 24 },
    "bodyS":     { "font": "body", "weight": 400, "size": 14, "lineHeight": 20 },
    "label":     { "font": "body", "weight": 600, "size": 12, "lineHeight": 16, "tracking": 0.08, "uppercase": true },
    "mono":      { "font": "mono", "weight": 400, "size": 13, "lineHeight": 20 }
  },
  "radius": { "sheet": 4, "control": 6, "card": 12, "pill": 999 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "9": 96 },
  "shadow": { "float": "0 8px 24px rgba(0,0,0,0.18)" },
  "motion": {
    "durFast": 150, "durBase": 220, "durSlow": 400,
    "easeOut": [0.2, 0.7, 0.2, 1],
    "einkRefresh": { "durationMs": 1600, "steps": 4, "$description": "invert → normal → invert → normal, stepped" }
  },
  "led": {
    "$description": "Dock LED language; apps mirror these in status pills",
    "starting":    { "color": "signalBlue", "pattern": "pulse", "periodMs": 1400 },
    "setup":       { "color": "signalBlue", "pattern": "blink", "periodMs": 1000 },
    "ready":       { "color": "reGreen",    "pattern": "breathe", "periodMs": 3000, "maxBrightness": 0.3 },
    "jobWaiting":  { "color": "reGreen",    "pattern": "blink", "periodMs": 1000 },
    "printing":    { "color": "reGreen",    "pattern": "blink", "periodMs": 330 },
    "printed":     { "color": "reGreen",    "pattern": "solid", "holdMs": 3000 },
    "needsDecision": { "color": "amber",    "pattern": "solid" },
    "failed":      { "color": "labelRed",   "pattern": "blink", "periodMs": 1000 },
    "noNetwork":   { "color": "labelRed",   "pattern": "solid" },
    "nextPage":    { "color": "reGreen",    "pattern": "doubleFlash", "$description": "between pages of a multi-page job, then back to jobWaiting" }
  }
}
