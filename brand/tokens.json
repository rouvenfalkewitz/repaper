        "$value": "#FBE3DF"
      }
    },
    "amber": {
      "500": {
        "$value": "#FFB020"
      },
      "700": {
        "$value": "#8F6100"
      },
      "900": {
        "$value": "#3A2A08"
      },
      "100": {
        "$value": "#FCEFD0"
      }
    },
    "blue": {
      "500": {
        "$value": "#4D8DFF"
      },
      "700": {
        "$value": "#2A62D6"
      },
      "900": {
        "$value": "#14264A"
      },
      "100": {
        "$value": "#DEE7FA"
      }
    },
    "epaper": {
      "black": {
        "$value": "#000000"
      },
      "white": {
        "$value": "#FFFFFF"
      },
      "red": {
        "$value": "#C8102E"
      },
      "yellow": {
        "$value": "#F2C400"
      },
      "panel": {
        "$value": "#E9EBE6"
      },
      "bezel": {
        "$value": "#1C2320"
      }
    },
    "led": {
      "$description": "RGB triplets for the Dock's light ring (WS2812 / RGB)",
      "reGreen": {
        "$value": [
          30,
          227,
          165
        ]
      },
      "labelRed": {
        "$value": [
          255,
          92,
          77
        ]
      },
      "amber": {
        "$value": [
          255,
          176,
          32
        ]
      },
      "signalBlue": {
        "$value": [
          77,
          141,
          255
        ]
      }
    }
  },
  "theme": {
    "carbon": {
      "bg": "#0C100F",
      "surface": "#151A18",
      "surface2": "#1C2320",
      "border": "#273029",
      "borderStrong": "#364139",
      "text": "#EFF1EE",
      "text2": "#A7B0AA",
      "text3": "#6C756F",
      "accent": "#1EE3A5",
      "accentHover": "#A9F5DC",
      "accentText": "#1EE3A5",
      "onAccent": "#0C100F",
      "accentTint": "#0A2E24",
      "red": "#FF5C4D",
      "amber": "#FFB020",
      "blue": "#4D8DFF",
      "glow": true
    },
    "paper": {
      "bg": "#EFF1EE",
      "surface": "#FAFBF9",
      "surface2": "#FFFFFF",
      "border": "#D6DAD6",
      "borderStrong": "#B9BFBA",
      "text": "#131614",
      "text2": "#454B47",
      "text3": "#8B928E",
      "accent": "#14C48E",
      "accentHover": "#0F9A70",
      "accentText": "#0B7259",
      "onAccent": "#131614",
      "accentTint": "#DCF3EA",
      "red": "#D6402F",
      "amber": "#8F6100",
      "blue": "#2A62D6",
      "glow": false
    }
  },
  "glow": {
    "box": "0 0 0 1px rgba(30,227,165,0.35), 0 0 28px rgba(30,227,165,0.35)",
    "text": "0 0 24px rgba(30,227,165,0.45)",
    "$description": "Screens showing Carbon only — primary element and LED renders. Glow is light, never ink: never printed or stitched."
  },
  "font": {
    "display": {
      "$value": "Archivo",
      "fallback": "Helvetica Neue, Arial, sans-serif",
      "weights": [
        600,
        700,
        800
      ],
      "widthAxis": [
        100,
        112,
        125
      ]
    },
    "body": {
      "$value": "Figtree",
      "fallback": "Segoe UI, Helvetica, Arial, sans-serif",
      "weights": [
        400,
        500,
        600,
        700
      ]
    },
    "mono": {
      "$value": "JetBrains Mono",
      "fallback": "SF Mono, Menlo, Consolas, monospace",
      "weights": [
        400,
        500,
        700
      ]
    },
    "onSheet": {
      "headline": "Archivo 700",
      "body": "Figtree 500+",
      "mono": "JetBrains Mono",
      "minSizePx": {
        "body": 12,
        "mono": 9
      },
      "$description": "1-bit rendering; no thin strokes"
    }
  },
  "typeScale": {
    "displayXl": {
      "font": "display",
      "weight": 800,
      "width": 125,
      "uppercase": true,
      "size": 72,
      "lineHeight": 64,
      "tracking": -0.03
    },
    "displayL": {
      "font": "display",
      "weight": 700,
      "width": 100,
      "size": 44,
      "lineHeight": 46,
      "tracking": -0.03
    },
    "displayM": {
      "font": "display",
      "weight": 700,
      "width": 100,
      "size": 28,
      "lineHeight": 32,
      "tracking": -0.02
    },
    "title": {
      "font": "display",
      "weight": 600,
      "width": 100,
      "size": 20,
      "lineHeight": 26,
      "tracking": -0.01
    },
    "eyebrow": {
      "font": "display",
      "weight": 700,
      "width": 112,
      "uppercase": true,
      "size": 12,
      "lineHeight": 16,
      "tracking": 0.12
    },
    "bodyL": {
      "font": "body",
      "weight": 400,
      "size": 18,
      "lineHeight": 28
    },
    "body": {
      "font": "body",
      "weight": 400,
      "size": 16,
      "lineHeight": 24
    },
    "bodyS": {
      "font": "body",
      "weight": 400,
      "size": 14,
      "lineHeight": 20
    },
    "mono": {
      "font": "mono",
      "weight": 400,
      "size": 13,
      "lineHeight": 20
    }
  },
  "wordmark": {
    "font": "Archivo",
    "weight": 800,
    "width": 125,
    "uppercase": true,
    "tracking": -0.03,
    "re": "re.400 on dark / re.500 on light",
    "paper": "paper on dark / ink on light",
    "glowOnDark": true
  },
  "radius": {
    "sheet": 4,
    "control": 8,
    "card": 16,
    "device": 28,
    "pill": 999
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64,
    "9": 96
  },
  "shadow": {
    "floatDark": "0 12px 32px rgba(0,0,0,0.5)",
    "floatLight": "0 8px 24px rgba(0,0,0,0.18)"
  },
  "motion": {
    "durFast": 150,
    "durBase": 220,
    "durSlow": 400,
    "easeOut": [
      0.2,
      0.7,
      0.2,
      1
    ],
    "einkRefresh": {
      "durationMs": 1600,
      "steps": 4,
      "$description": "invert → normal → invert → normal, stepped"
    },
    "ringBreathe": {
      "durationMs": 3000,
      "min": 0.35,
      "max": 1.0,
      "easing": "ease-in-out"
    }
  },
  "led": {
    "$description": "Dock light-ring language; app status pills mirror these",
    "starting": {
      "color": "signalBlue",
      "pattern": "pulse",
      "periodMs": 1400
    },
    "setup": {
      "color": "signalBlue",
      "pattern": "blink",
      "periodMs": 1000
    },
    "ready": {
      "color": "reGreen",
      "pattern": "breathe",
      "periodMs": 3000,
      "maxBrightness": 0.3
    },
    "jobWaiting": {
      "color": "reGreen",
      "pattern": "blink",
      "periodMs": 1000
    },
    "printing": {
      "color": "reGreen",
      "pattern": "blink",
      "periodMs": 330
    },
    "printed": {
      "color": "reGreen",
      "pattern": "solid",
      "holdMs": 3000
    },
    "needsDecision": {
      "color": "amber",
      "pattern": "solid"
    },
    "failed": {
      "color": "labelRed",
      "pattern": "blink",
      "periodMs": 1000
    },
    "noNetwork": {
      "color": "labelRed",
      "pattern": "solid"
    },
    "nextPage": {
      "color": "reGreen",
      "pattern": "doubleFlash"
    }
  },
  "print": {
    "$description": "Flat spot colour on black. Pantone for 'Re Green, printed' to be picked from a physical swatch book (neon-mint range, ~3385 C / 7479 C or fluorescent).",
    "reGreenPantone": null,
    "printedGlow": "1-bit dither fade re.400 -> carbon.1, two flat colours",
    "allowed": [
      "carbon",
      "reGreen",
      "white"
    ],
    "forbidden": [
      "halo",
      "gradient",
      "drop shadow",
      "foil",
      "metallic"
    ]
  }
}
