# Public hostname (used by Traefik routing labels in docker-compose.yml)
DOMAIN=repaper.schisch.net

# Outgoing mail (invitations). "console" logs instead of sending — invites then
# show their link in the UI for hand-delivery. Set to "smtp" once the mailbox exists.
MAIL_TRANSPORT=console
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=repaper@schisch.net
SMTP_PASS=
MAIL_FROM=RePaper Cloud <repaper@schisch.net>

# Self-registration whitelist: comma-separated full emails and/or @domains.
# Whitelisted addresses get a confirmation mail and start their OWN personal
# workspace (joining an existing organisation is what invitations are for);
# everyone else sees the same neutral reply and nothing happens. Empty =
# registration link exists but admits nobody (invites still work).
REGISTER_WHITELIST=
